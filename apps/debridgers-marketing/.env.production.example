# Production environment for the debridgers-marketing application.
# Copy to .env.production.
#
# Pointed at the test backend for now, same as staging - there is no separate
# production API deployed yet. Swap this one value when there is; nothing
# else about the setup changes.
VITE_API_URL=https://api-test.debridgers.com/api/v1
NODE_ENV=production
PORT=5173

VITE_BUYER_APP_URL=https://buyer.debridgers.com
VITE_AGENT_APP_URL=https://agent.debridgers.com
VITE_ADMIN_APP_URL=https://admin.debridgers.com
