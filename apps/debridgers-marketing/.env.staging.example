# Staging/test environment for the debridgers-marketing application.
# Copy to .env.staging.
#
# Same test backend as .env.development's fallback for now - there is only one
# deployed environment today. When a real staging backend exists, point this
# file at it.
VITE_API_URL=https://api-test.debridgers.com/api/v1
NODE_ENV=production
PORT=5173

# Every role app has its own staging subdomain, all following this site's
# own test.debridgers.com pattern: a hyphenated "-test" prefix on the apex
# domain rather than a nested subdomain (buyer-test, not buyer.test).
VITE_BUYER_APP_URL=https://buyer-test.debridgers.com
VITE_AGENT_APP_URL=https://agent-test.debridgers.com
VITE_ADMIN_APP_URL=https://admin-test.debridgers.com
VITE_CAREERS_APP_URL=https://careers-test.debridgers.com
