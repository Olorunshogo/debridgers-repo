# Staging/test environment for the debridgers-marketing application.
# Copy to .env.staging.
#
# Same test backend as .env.development's fallback for now - there is only one
# deployed environment today. When a real staging backend exists, point this
# file at it.
VITE_API_URL=https://api-test.debridgers.com/api/v1
NODE_ENV=production
PORT=5173

# Buyer/agent/admin staging subdomains do not exist yet, so these point at
# the same origin as production for now. Update once each role app has its
# own deployed staging subdomain.
VITE_BUYER_APP_URL=https://buyer.debridgers.com
VITE_AGENT_APP_URL=https://agent.debridgers.com
VITE_ADMIN_APP_URL=https://admin.debridgers.com

# Careers staging IS a real, separate subdomain: careers-test rather than
# careers.test, matching this site's own test.debridgers.com pattern of a
# hyphenated prefix on the apex domain rather than a nested subdomain.
VITE_CAREERS_APP_URL=https://careers-test.debridgers.com
