# Local development environment for the debridgers-marketing application.
# Copy to .env.development and adjust if you're running against a deployed
# backend instead.
#
# Points at your own local backend by default - run `pnpm dev:backend`
# alongside this. Point VITE_API_URL at https://api-test.debridgers.com/api/v1
# instead (or use `pnpm dev:staging`) if you want frontend-only work against
# the shared test backend without running Postgres/the backend yourself.
VITE_API_URL=http://localhost:4001/api/v1
NODE_ENV=development
PORT=5173

# Where the checkout gate and role-selection screen send a user for each role's
# dashboard app. Local dev talks to each app's own Vite dev server directly.
VITE_BUYER_APP_URL=http://localhost:5174
VITE_AGENT_APP_URL=http://localhost:5175
VITE_ADMIN_APP_URL=http://localhost:5176
