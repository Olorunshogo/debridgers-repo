# === Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debridgers

# === JWT
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# === Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Mailtrap
MAILTRAP_TOKEN=a_random_31_alphanumeric_charcters
MAILTRAP_FROM_EMAIL=noreply@debridgers.com
MAILTRAP_FROM_NAME=Debridgers
MAILTRAP_SENDER_EMAIL=
MAILTRAP_API_TOKEN=

# === Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
AGENT_COMMISSION_RATE=0.30

# === Redis (optional — falls back to in-memory cache if not set)
UPSTASH_REDIS_URL=
JWT_TOKEN=64_random_hex_bytes

# === App
APP_URL=http://localhost:3000
PORT=4000

# === Seed
ADMIN_EMAIL=admin@debridgers.com
ADMIN_PASSWORD=

MAILTRAP_SENDER_EMAIL=mailtrap@mailtrap-example-email.com
MAILTRAP_API_TOKEN=a_random_31_alphanumeric_charcters
