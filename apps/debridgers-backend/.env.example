# === Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/debridgers"

# Neon PostgreSQL (use pooler URL in production)
# DATABASE_URL="postgresql://<user>:<pass>@<ep>-pooler.neon.tech/<db>?sslmode=require"

# === Access and Refresh Tokens
ACCESS_TOKEN_SECRET="change_me_64_random_hex_bytes"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_SECRET="change_me_64_random_hex_bytes"
REFRESH_TOKEN_EXPIRY="7d"

# === Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# === Redis / Upstash (optional — falls back to in-memory cache if unset)
UPSTASH_REDIS_URL="rediss://default:<token>@<host>.upstash.io:6379"

# === Mailtrap
MAILTRAP_TOKEN="your_mailtrap_api_token"
MAILTRAP_FROM_EMAIL="noreply@debridgers.com"
MAILTRAP_FROM_NAME="Debridgers"

# === Paystack (Payment Gateway)
# Get these from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_test_..."  # sk_test_... for testing, sk_live_... for production
PAYSTACK_PUBLIC_KEY="pk_test_..."  # pk_test_... for testing, pk_live_... for production
PAYSTACK_WEBHOOK_SECRET="whsec_..."  # From Webhooks section in Paystack dashboard

# Preferred dedicated-account provider slug. Leave unset to take the first one
# your integration offers: test integrations only have test-bank, live ones have
# wema-bank or titan-paystack. See GET /dedicated_account/available_providers.
PAYSTACK_PREFERRED_BANK=""

# Skips the payment gateway at checkout and marks orders paid immediately, so
# the flow can be walked without taking money. Development and tests only: the
# server refuses to boot with this enabled while NODE_ENV=production.
PAYMENTS_SIMULATED="false"

# === Agent Commission & Payouts
AGENT_COMMISSION_RATE="5"            # Commission percentage (0-100)
MIN_PAYOUT_AMOUNT="50000"            # Minimum payout in kobo (₦5,000 = 50000 kobo)

# === Scheduled Payouts (Weekly Withdrawals to Agent Bank Accounts)
# Cron format: minute hour dayOfMonth month dayOfWeek
# Example: "0 10 * * 5" = Friday 10:00 AM UTC
PAYOUT_SCHEDULE_CRON="0 10 * * 5"   # Friday 10 AM UTC (adjust to your timezone)

# === CORS (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS="http://localhost:5173,https://yourdomain.com"

# === Admin Seed Credentials
ADMIN_EMAIL="admin@debridgers.com"
ADMIN_PASSWORD="WGxMWQP8RfIMjNWVTpJo"

# === App
PORT="4000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
UV_THREADPOOL_SIZE="16"
ALLOWED_ORIGINS=http://localhost:PORT


# REQUEST_KEY, ADMIN_KEY_1, ADMIN_KEY_2, PAYMENT_KEY_1 and PAYMENT_KEY_2 were
# removed 2026-09-05: keys.guard.ts / BaseKeysGuard, the guard that read them,
# no longer exists anywhere in src. Nothing checks these values; do not
# reintroduce them without a guard that actually reads them again.

# === Super admin API keys (admin-key.guard.ts)
# Only needed for callers that authenticate with X-Admin-Key + X-Admin-Tier
# headers, such as scripts hitting the admin API directly. The browser uses the
# JWT path and needs none of this.
#
# Note these are NOT the ADMIN_KEY_1/2 above - different guard, different names.
# Leave empty unless you use the header path: a caller that sends the headers
# with these unset gets "Super admin keys not configured" rather than access.
SUPER_ADMIN_KEY_1=""
SUPER_ADMIN_KEY_2=""

# === Session binding (auth.service.ts)
# off | device | strict. Defaults to device when unset.
SESSION_BINDING=""

# === Analytics (posthog.service.ts)
# Must be a PROJECT key ("phc_…"). A personal key ("phx_…") is rejected by the
# ingestion endpoint and analytics disables itself with a warning at boot.
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
