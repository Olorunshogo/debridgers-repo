{
  "name": "@debridgers/debridgers-backend",
  "version": "1.0.0",
  "description": "Debridgers backend API: NestJS + Drizzle",
  "main": "dist/main.js",
  "scripts": {
    "dev": "UV_THREADPOOL_SIZE=16 nest start --watch",
    "dev:migrate": "pnpm db:generate && UV_THREADPOOL_SIZE=16 nest start --watch",
    "build": "nest build",
    "start": "UV_THREADPOOL_SIZE=16 node dist/main.js",
    "start:migrate": "pnpm db:generate && UV_THREADPOOL_SIZE=16 node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest --run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/infrastructure/seeders/seeder.ts",
    "db:seed:careers-jobs": "tsx src/infrastructure/seeders/careers-jobs-seeder.ts",
    "db:seed:dev": "tsx src/infrastructure/seeders/dev-seeder.ts",
    "db:seed:dev:reset": "tsx src/infrastructure/seeders/dev-seeder.ts reset",
    "db:reset": "tsx src/infrastructure/seeders/dev-seeder.ts reset",
    "docker:up": "docker compose -p debridgers -f ../../docker/docker-compose.yml up postgres redis -d --wait",
    "docker:down": "docker compose -p debridgers -f ../../docker/docker-compose.yml down",
    "docker:migrate": "pnpm docker:up && pnpm db:migrate"
  },
  "dependencies": {
    "@debridgers/pricing": "workspace:*",
    "@debridgers/ratings": "workspace:*",
    "@keyv/redis": "^5.1.6",
    "@neondatabase/serverless": "^1.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "cacheable": "^2.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "file-stream-rotator": "^1.0.0",
    "helmet": "^8.2.0",
    "keyv": "^5.6.0",
    "mailtrap": "^4.5.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nestjs-pino": "^4.5.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^10.5.0",
    "posthog-node": "^5.48.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.17",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22",
    "@types/pg": "^8.11.14",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^1.6.1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1"
}
