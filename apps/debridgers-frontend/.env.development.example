# Local development environment for the debridgers-frontend application.
# Copy to .env.development and adjust if you're running the backend locally.
#
# Pointed at the test backend by default so you never need Postgres or the
# backend server running locally just to work on the frontend. Point it at
# http://localhost:4001/api/v1 instead if you are actively changing the
# backend and need to hit your own local instance.
VITE_API_URL=https://api-test.debridgers.com/api/v1
NODE_ENV=development
PORT=5173
