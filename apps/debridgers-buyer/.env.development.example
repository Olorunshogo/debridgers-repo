# Local development environment for the debridgers-buyer application.
# Copy to .env.development and adjust if you're running against a deployed
# backend instead.
#
# Points at your own local backend by default - run `pnpm dev:backend`
# alongside this. Point VITE_API_URL at https://api-test.debridgers.com/api/v1
# instead if you want frontend-only work against the shared test backend
# without running Postgres/the backend yourself.
VITE_API_URL=http://localhost:4002/api/v1
NODE_ENV=development
PORT=5174
