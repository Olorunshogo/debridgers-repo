{
  "name": "debridgers-careers",
  "root": "apps/debridgers-careers",
  "sourceRoot": "apps/debridgers-careers/app",
  "projectType": "application",
  "tags": ["scope:frontend", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/debridgers-careers"
      }
    },
    "build:staging": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "command": "pnpm run build:staging",
        "cwd": "apps/debridgers-careers"
      }
    },
    "build:production": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "command": "pnpm run build:production",
        "cwd": "apps/debridgers-careers"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev",
        "cwd": "apps/debridgers-careers"
      }
    },
    "dev:staging": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev:staging",
        "cwd": "apps/debridgers-careers"
      }
    },
    "dev:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev:production",
        "cwd": "apps/debridgers-careers"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run start",
        "cwd": "apps/debridgers-careers"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "apps/debridgers-careers"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "apps/debridgers-careers"
      }
    }
  }
}
