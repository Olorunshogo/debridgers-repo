# Staging/test environment for the debridgers-agent application.
# Copy to .env.staging.
#
# Same test backend as .env.development for now - there is only one deployed
# environment today. When a real staging backend exists, point this file at
# it and .env.development can go back to localhost if that's ever the norm.
VITE_API_URL=https://api-test.debridgers.com/api/v1
NODE_ENV=production
PORT=5175
