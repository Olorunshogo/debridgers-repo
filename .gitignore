# Dependencies
node_modules
.pnpm-store/

# Build outputs
dist
build
.output
.cache
!build/functions/

# Testing
coverage
.nyc_output

# Environment variables. Any name (.env, prod.env, staging.env), any depth.
# Real secrets never get committed; only *.example templates are allowed. This
# list is wider than ".env*" because a "prod.env" slipped past that and shipped
# live keys - see the pre-commit guard and the incident note below.
.env
.env.*
*.env
!.env.example
!.env.*.example
!*.env.example
.kiro

# Keys and certificates. debridgers_data_config/ carried real committed private
# keys and hex secrets with nothing in the codebase referencing them - removed
# 2026-09-05. This rule is here so that mistake cannot repeat quietly.
*.pem
*.key
*.crt
*.p12
*.pfx


# IDE
.idea
*.sublime-*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System files
.DS_Store
Thumbs.db

# Package manager files
.pnpm-debug.log
.npmrc

# Temporary filess
tmp
*.tmp
*.temp
.cache
.turbo
.qodo

# Generated files
.generated
stats.html
tsconfig.tsbuildinfo
.eslintcache

# Remix specific
/public/build
/api/index.js
/api/index.js.map


.nx/cache
.nx/workspace-data

storybook-static
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

vite.config.*.timestamp*
vitest.config.*.timestamp*
test-output

.nx/polygraph
.vercel
.claude/

# Ignored Folder
docs/Screens/
docs/*-snippets.md

# Declaration output emitted next to sources by a stray tsc run.
# Specs and test support files are never consumed as types, so any .d.ts
# beside them is build residue.
apps/debridgers-backend-e2e/src/**/*.d.ts

# Build output must never sit beside its source: a stale compiled copy in
# packages/*/src wins module resolution over the .ts next to it, so an edited
# rate silently has no effect. Compiled output belongs in dist/.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Tunnel credentials for the self-hosted deploy, never committed.
~/credentials.json

# React Router's generated route types, per app. Each app's own .gitignore
# already carries this too, but a build cache left behind at a stale path
# (e.g. after a rename) has no per-app .gitignore of its own to be caught by -
# this blanket rule is the backstop for exactly that case.
**/.react-router/
