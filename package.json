{
  "name": "debridgers-repo",
  "version": "1.0.0",
  "description": "A marketplace platform connecting farmers directly with buyers for fresh farm produce.",
  "private": true,
  "main": "index.js",
  "keywords": [
    "farm",
    "produce",
    "marketplace",
    "farmers",
    "buyers",
    "fresh-produce",
    "agriculture",
    "farm-to-table",
    "ecommerce",
    "monorepo"
  ],
  "scripts": {
    "dev": "nx run-many -t dev serve --parallel",
    "build": "nx run-many -t build",
    "start": "nx run-many -t start serve --parallel",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "analyze": "pnpm --filter @debridgers/debridgers-frontend analyze",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "prepare": "husky || true",
    "dev:frontend": "nx dev debridgers-frontend",
    "build:frontend": "nx build debridgers-frontend",
    "start:frontend": "nx start debridgers-frontend",
    "typecheck:frontend": "nx typecheck debridgers-frontend",
    "lint:frontend": "nx lint debridgers-frontend",
    "lint:fix:frontend": "pnpm --filter @debridgers/debridgers-frontend lint:fix",
    "dev:backend": "nx serve debridgers-backend",
    "build:backend": "nx build debridgers-backend",
    "start:backend": "pnpm --filter @debridgers/debridgers-backend start",
    "typecheck:backend": "nx typecheck debridgers-backend",
    "lint:backend": "nx lint debridgers-backend",
    "lint:fix:backend": "pnpm --filter @debridgers/debridgers-backend lint:fix",
    "db:migrate": "tsx apps/debridgers-backend/src/migrate.ts",
    "db:generate": "nx run debridgers-backend:db --args='generate'",
    "db:drop": "nx run debridgers-backend:db --args='drop'",
    "db:studio": "nx run debridgers-backend:db --args='studio'",
    "db:seed": "pnpm --filter @debridgers/debridgers-backend db:seed",
    "db:seed:dev": "pnpm --filter @debridgers/debridgers-backend db:seed:dev",
    "db:seed:dev:reset": "pnpm --filter @debridgers/debridgers-backend db:seed:dev:reset",
    "debridgers-backend:generate": "nx run debridgers-backend:db --args='generate'",
    "debridgers-backend:seed": "nx run debridgers-backend:db --args='seed'",
    "debridgers-backend:drop": "nx run debridgers-backend:db --args='drop'",
    "debridgers-backend:migrate": "nx run debridgers-backend:db --args='migrate'",
    "debridgers-backend:studio": "nx run debridgers-backend:db --args='studio'",
    "debridgers-backend:seed:dev": "pnpm --filter @debridgers/debridgers-backend db:seed:dev",
    "debridgers-backend:seed:dev:reset": "pnpm --filter @debridgers/debridgers-backend db:seed:dev:reset",
    "db:push": "nx run debridgers-backend:db --args='push'",
    "docker:up": "docker compose -p debridgers -f docker/docker-compose.yml up postgres redis -d --wait",
    "docker:down": "docker compose -p debridgers -f docker/docker-compose.yml down",
    "docker:migrate": "pnpm docker:up && pnpm db:migrate",
    "test:e2e": "nx test debridgers-backend-e2e",
    "dev:ui-web": "pnpm --filter @debridgers/ui-web dev",
    "build:ui-web": "pnpm --filter @debridgers/ui-web build",
    "watch:ui-web": "pnpm --filter @debridgers/ui-web watch",
    "audit:spacing-tokens": "sh scripts/audit-spacing-tokens.sh",
    "dev:pricing": "pnpm --filter @debridgers/pricing dev",
    "build:pricing": "pnpm --filter @debridgers/pricing build"
  },
  "devDependencies": {
    "@nx/eslint": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/nest": "22.6.5",
    "@nx/node": "22.6.5",
    "@nx/react": "22.6.5",
    "@nx/vite": "22.6.5",
    "@nx/vitest": "22.6.5",
    "@nx/webpack": "22.6.5",
    "@react-router/dev": "7.13.2",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "latest",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.0.1",
    "typescript": "^5.9.2",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "validate-branch-name": {
    "pattern": "^(main|develop|live){1}$|^(feature|fix|refactor|hotfix|release|conflict|chore)/.+$",
    "errorMsg": "Branch name structure: feature/short-description\nAllowed prefixes: feature, fix, refactor, hotfix, release, conflict, chore"
  },
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "posthog-node": "^5.48.1"
  }
}
