#!/usr/bin/env sh

set -e

# The payload writes into a build config on disk and `git add` sweeps it up with
# real work. This is the moment that happens, so this is where to catch it.
echo "🔎 Scanning staged files for the EtherHiding backdoor..."
bash scripts/scan-backdoor.sh --staged

echo "🔒 Checking for staged env files..."
blocked_env=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.env($|\.)' | grep -vE '\.(example|sample|template)$' || true)
if [ -n "$blocked_env" ]; then
  echo "✋ Refusing to commit env file(s) - these hold secrets:"
  echo "$blocked_env" | sed 's/^/   - /'
  echo "   Rename to *.env.example with no real values, or add it to .gitignore."
  exit 1
fi

echo "🔒 Scanning staged files for secrets..."
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact -v || {
    echo "✋ Possible secret detected in staged changes. Commit aborted."
    echo "   A real secret: rotate it, then remove it from the staged diff."
    echo "   A false positive: rerun with --no-verify only if you are certain."
    exit 1
  }
else
  echo "⚠️  gitleaks not installed - skipping local secret scan (CI still runs it)."
  echo "   Install: https://github.com/gitleaks/gitleaks#installing"
fi

echo "💅 Fixing lint & formatting staged files..."
pnpm lint-staged

echo "✅ Pre-commit checks passed."
